{
  "name": "vscode-extensions",
  "private": true,
  "workspaces": [
    "extensions/*",
    "!extensions/file-icons"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch --workspace ai-agents",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace ai-agents",
    "test:hygiene": "npm run test:hygiene --workspace ai-agents",
    "test:integration": "npm run test:integration --workspace ai-agents",
    "test:protocol": "npm run test:protocol --workspace ai-agents",
    "test:live": "npm run test:live --workspace ai-agents",
    "test:tools": "npm run test:tools --workspace ai-agents",
    "test:runtime": "npm run test:runtime --workspace ai-agents",
    "package": "npm run package --workspace ai-agents",
    "test:ui": "npm run test:ui --workspace ai-agents",
    "test:gui:acceptance": "node extensions/ai-agents/scripts/gui-acceptance.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.109.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
