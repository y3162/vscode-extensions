{
  "publisher": "y3162",
  "name": "file-icons",
  "displayName": "File Icons",
  "type": "module",
  "version": "1.26.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "description": "File and folder icons for VS Code and VSCodium.",
  "author": "y3162",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/y3162/vscode-extensions.git",
    "directory": "extensions/file-icons"
  },
  "bugs": {
    "url": "https://github.com/y3162/vscode-extensions/issues"
  },
  "keywords": [
    "theme",
    "fancy",
    "pastel-colors",
    "vscode",
    "vscode-theme",
    "vscode-icons",
    "vscode-extension"
  ],
  "categories": [
    "Themes"
  ],
  "main": "dist/main.cjs",
  "browser": "dist/browser.cjs",
  "icon": "assets/icon.png",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.83.0",
    "node": ">=20.0.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tensorboard-events",
        "aliases": ["TensorBoard Events"],
        "filenamePatterns": ["events.out.tfevents.*"]
      }
    ],
    "configuration": {
      "title": "File Icons",
      "properties": {
        "file-icons.hidesExplorerArrows": {
          "type": "boolean",
          "default": false,
          "description": "Hides arrows next to folders in the explorer."
        },
        "file-icons.specificFolders": {
          "type": "boolean",
          "default": true,
          "description": "Display specific folder icons. Disable to only use default folder icon."
        },
        "file-icons.monochrome": {
          "type": "boolean",
          "default": false,
          "description": "Only use Text color for icons."
        },
        "file-icons.associations.languages": {
          "type": "object",
          "default": {},
          "description": "Custom languageId/icon associations."
        },
        "file-icons.associations.extensions": {
          "type": "object",
          "default": {},
          "description": "Custom fileExtension/icon associations."
        },
        "file-icons.associations.files": {
          "type": "object",
          "default": {},
          "description": "Custom fileName/icon associations."
        },
        "file-icons.associations.folders": {
          "type": "object",
          "default": {},
          "description": "Custom folderName/icon associations."
        }
      }
    },
    "commands": [
      {
        "command": "file-icons.reset",
        "title": "File Icons: Factory reset settings"
      }
    ],
    "iconThemes": [
      {
        "id": "file-icons-mocha",
        "label": "File Icons Mocha",
        "path": "./dist/mocha/theme.json"
      },
      {
        "id": "file-icons-latte",
        "label": "File Icons Latte",
        "path": "./dist/latte/theme.json"
      },
      {
        "id": "file-icons-frappe",
        "label": "File Icons Frappé",
        "path": "./dist/frappe/theme.json"
      },
      {
        "id": "file-icons-macchiato",
        "label": "File Icons Macchiato",
        "path": "./dist/macchiato/theme.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "catwalk": "tsx scripts/catwalk.ts",
    "icons:generate": "tsx scripts/icons/generate.ts",
    "icons:optimize": "tsx scripts/icons/optimize.ts",
    "icons:preview": "tsx scripts/icons/preview.ts",
    "icons": "pnpm run --sequential '/^icons:.*/'",
    "previews": "npx puppeteer browsers install chrome && pnpm run icons:preview && pnpm run catwalk",
    "integrity": "tsx scripts/integrity.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "changelogen --release",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@antfu/eslint-config": "^5.4.1",
    "@catppuccin/palette": "^1.7.1",
    "@iconify/tools": "^4.1.4",
    "@types/node": "^24.7.2",
    "@types/vscode": "1.83.0",
    "@vscode/vsce": "^3.6.2",
    "changelogen": "^0.6.2",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "eslint": "^9.37.0",
    "lint-staged": "^16.2.4",
    "lookpath": "^1.2.3",
    "puppeteer": "^24.24.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
